{
  "name": "color-space-kit",
  "version": "1.0.0",
  "description": "颜色转换与计算：hex/rgb/hsl/hsv 互转、WCAG 对比度、混合、明暗判断，零依赖、全 TypeScript",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "color",
    "rgb",
    "hex",
    "hsl",
    "hsv",
    "contrast",
    "wcag",
    "accessibility",
    "mix",
    "typescript"
  ],
  "author": "jackiechan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcy-24/color-space-kit.git"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
